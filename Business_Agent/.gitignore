-- ===========================

-- 3. Queries

-- ===========================
 
-- c. Names of customers in ascending order

SELECT CustomerName

FROM Customer

ORDER BY CustomerName ASC;
 
-- d. Names of products in descending order of price

SELECT DISTINCT p.ProductName, cp.Price

FROM Product p

JOIN CustomerProduct cp ON p.ProductID = cp.ProductID

WHERE cp.Price IS NOT NULL

ORDER BY cp.Price DESC;
 
-- e. Total count of products available in the sales record

SELECT COUNT(DISTINCT ProductID) AS TotalProducts

FROM CustomerProduct;
 
-- f. Names of customers who bought 'Hair dryer'

SELECT DISTINCT c.CustomerName

FROM Customer c

JOIN CustomerProduct cp ON c.CustomerID = cp.CustomerID

JOIN Product p ON cp.ProductID = p.ProductID

WHERE p.ProductName = 'Hair dryer';
 
-- g. Number of products purchased by each customer

SELECT c.CustomerName,

       COUNT(cp.ProductID) AS NumberOfProducts

FROM Customer c

LEFT JOIN CustomerProduct cp

ON c.CustomerID = cp.CustomerID

GROUP BY c.CustomerID, c.CustomerName;
 
-- h. Total price paid by each customer

SELECT c.CustomerName,

       COALESCE(SUM(cp.Price), 0) AS TotalPrice

FROM Customer c

LEFT JOIN CustomerProduct cp

ON c.CustomerID = cp.CustomerID

GROUP BY c.CustomerID, c.CustomerName;
 
-- i. Customer who purchased the highest amount

SELECT c.CustomerName,

       SUM(cp.Price) AS TotalAmount

FROM Customer c

JOIN CustomerProduct cp

ON c.CustomerID = cp.CustomerID

GROUP BY c.CustomerID, c.CustomerName

ORDER BY TotalAmount DESC

LIMIT 1;
 
-- j. Update the price of Clippers to $1

UPDATE CustomerProduct

SET Price = 1

WHERE ProductID = (

    SELECT ProductID

    FROM Product

    WHERE ProductName = 'Clippers'

);
 
-- Verify the update

SELECT p.ProductName, cp.Price

FROM Product p

JOIN CustomerProduct cp

ON p.ProductID = cp.ProductID

WHERE p.ProductName = 'Clippers';
 